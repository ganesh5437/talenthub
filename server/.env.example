# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string (Neon dashboard -> Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Any long random string. Changing it logs everybody out.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: comma-separated frontend URLs allowed to call the API (leave empty to allow all)
CORS_ORIGIN="http://localhost:5173,https://talenthub-app.netlify.app"

PORT=5000
